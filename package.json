{
  "name": "@wakeshift/sdk",
  "version": "0.5.0",
  "description": "Let agents subscribe to things in your app: Wakeshift wakes them when you emit an event.",
  "license": "Apache-2.0",
  "author": "Clawvisor Inc. <support@wakeshift.ai>",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "agents",
    "events",
    "webhooks",
    "wakeshift"
  ],
  "homepage": "https://github.com/wakeshift/wakeshift-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wakeshift/wakeshift-node.git"
  },
  "bugs": {
    "url": "https://github.com/wakeshift/wakeshift-node/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test 'build-test/test/*.test.js' && npm run examples",
    "examples": "node scripts/check-examples.mjs",
    "prepack": "npm run build",
    "pack-check": "sh scripts/pack-check.sh"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.20.5",
    "expect-type": "^1.4.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
