# Your Wakeshift app's key. `npx -y @wakeshift/cli init` writes it here,
# or paste one from the console (https://app.wakeshift.ai, New app).
WAKESHIFT_KEY=

# Send events to the local Inngest Dev Server. In production, remove it and
# set INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY from your Inngest dashboard.
INNGEST_DEV=1
